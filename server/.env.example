# BaitCheck server environment variables
# Copy this file to .env and fill in real values before starting the server.

PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/baitcheck
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
GEMINI_API_KEY=your-gemini-api-key-here
# Copy the exact ID printed by "npm run ai:models". Gemini 2.0 models have no free quota; 2.5 models were scheduled for shutdown. Never hardcode a model name in code.
LLM_MODEL=
CLIENT_URL=http://localhost:5173

# Optional — positive integer, suggested starting value 12
# LLM_MAX_RPM=12
# LLM_TIMEOUT_MS=20000
# LLM_THINKING_LEVEL=low  # minimal, low, medium, or high
# LLM_MODEL_JUDGE=
