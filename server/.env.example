# BaitCheck server environment variables
# Copy this file to .env and fill in real values before starting the server.

PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/baitcheck
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-2.0-flash
CLIENT_URL=http://localhost:5173

# Optional — positive integer, defaults to 10
# LLM_MAX_RPM=10
